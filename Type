from pyrogram import Client, filters
import asyncio

# Используем client вместо app, так как в модулях он передается аргументом
# В декораторах юзерботов часто используется 'app' или 'bot', 
# но если ты загружаешь модуль извне, лучше использовать объект клиента, 
# который уже инициализирован в системе.
# Если бот использует библиотеку для модулей, попробуй найти, как она регистрирует команды.

async def type_handler(client, message):
    if len(message.command) > 1:
        text_to_type = " ".join(message.command[1:])
        await message.delete()
        
        current_text = ""
        msg = await client.send_message(message.chat.id, "...")
        
        for char in text_to_type:
            current_text += char
            try:
                await msg.edit(f"<code>{current_text}▋</code>")
                await asyncio.sleep(0.05)
            except Exception:
                await asyncio.sleep(1)
        
        await msg.edit(f"<code>{current_text}</code>")
    else:
        await message.edit("Используй: .type <текст>")
